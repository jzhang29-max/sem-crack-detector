# Data and outputs -- these are 12 GB and belong in the lab's storage, not git.
# Everything here is regenerable from original/ plus the correction masks.
original/*.tif
original/*.tiff
results/
figures/
training_data/*.png
training_data/*_cracks.csv
fusion_cache/
removed_images/
round4_original_backup/
pipeline_diagram/*.png

# Keep the human labels: they are the irreplaceable part. Everything else can be
# recomputed, but nobody can recreate a person's crack verdicts.
!interior_active_learning/labels/
!interior_active_learning/paint/*_correction_mask.png
# Templates are derived from the model, so they are not worth versioning.
interior_active_learning/paint/*_paint_template.png
interior_active_learning/paint/*_painted.png

.venv/
__pycache__/
*.pyc
.DS_Store
.upload_*

# Quicklook renders -- derived previews, tens of MB each
interior_active_learning/candidates/*_quicklook.png
